{
  "name": "app.onboarding.project.compact",
  "steps": [
    { "cmd": "theme", "args": ["Axfterm Studio Custom"] },
    { "cmd": "variant", "args": ["dark"] },
    { "cmd": "size", "args": ["1024x720"] },
